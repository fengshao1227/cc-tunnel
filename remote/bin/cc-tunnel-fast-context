#!/usr/bin/env bash
# Optional MCP server: natural-language code search (fast-context-mcp) running
# on the local machine, against the canonical tree.
#
# It reads its Windsurf key from local state on that machine, so no credential
# is ever copied to this host. Its tools take an absolute project path - take it
# from workspace_status.
set -euo pipefail
# shellcheck source=/dev/null
. "${CC_TUNNEL_REMOTE_ENV:-$HOME/.config/cc-tunnel/remote.env}"

exec ssh -F "$HOME/.ssh/config" cc-tunnel-mac \
  "export PATH=$(printf '%q' "$CC_TUNNEL_MAC_PATH"):\$PATH; exec npx -y --prefer-online fast-context-mcp@latest"
